# -*- coding: utf-8 -*-
# =============================================================================
# topology-100m — arm-1 of the H59 falsification ladder: TOPOLOGY ONLY
#
# Isolates the single claim "interleaved diff-attention/MoD blocks + the
# NeuralGeometryAdapter beat a flat transformer" from everything else BRIAN
# does. Differs from architectures/control-100m in EXACTLY TWO fields:
#
#   block_pattern:     "standard" -> "interleave"
#   geometry_adapters: false      -> true
#
# Everything else — recipe, data, tokenizer, no multi-cortex, no VBB/MSPCC/
# BMA/STE/GIF, no cosine head, no PCH aux — is identical to control-100m.
# This is deliberate: the full BRIAN stack runs ~15 mechanisms
# simultaneously (confounded — a loss there doesn't tell you topology
# lost, it tells you the STACK lost). This arm answers the narrower,
# actually-useful question first.
#
# Also fixes the throughput complaint the full stack has: no frozen
# multi-cortex experts means no per-step cross-tokenizer bridge tax, so
# this arm should run close to control's native GPU throughput instead of
# the ~2-4k tok/s the 3-expert ensemble costs.
#
# Contract pinned by tests/dsl/test_control_arm.py::TestTopologyOnlyArch:
#   * block_pattern "interleave", geometry_adapters true.
#   * Every other training-recipe field identical to control-100m
#     (TestTopologyRecipeParity — same fields TestRecipeParity already
#     pins between control and SmolLM).
#   * No experts, no novel-topology modules, no cosine head, no PCH aux.
#   * Trainable params within 5% of control-100m's (same param-matching
#     discipline as the control-vs-SmolLM comparison).
#
# Ladder position: arm-0 control-100m -> arm-1 topology-100m (this file)
#   -> arm-2 +VBB waist -> arm-3 full SmolLM stack. See docs/findings.md
#   H59 for the pre-registered comparison plan.
#
# Deploy:  brian deploy architectures/topology-100m --steps N
# Compare: brian ood compare <control_result.json> <topology_result.json>
# =============================================================================

architecture topology: {
    d_sem: 256,
    dt: 0.01
}

training {
    preset:        "rcc_bowtie_30m_p4"

    # ── The ONE variable this arm changes vs control-100m ──
    block_pattern:     "interleave"
    geometry_adapters: true

    # ── Everything below is IDENTICAL to control-100m ──
    cosine_head:       false
    pred_coding_weight: 0.0

    loss_clipping: { enabled: true, method: "per_sample", factor: 3.0 }
    quantization:  { enabled: false, bits: 8 }
    optimizer:     "adamw"
    learning_rate: 0.0005
    warmup_steps:  2400
    min_lr_ratio:  0.1
    weight_decay:  0.01
    grad_accum:    8
    grad_clip:     1.0
    label_smoothing: 0.0
    dropout:       0.1
    flooding_level: 0.0
    stochastic_depth: 0.0
    z_loss: 0.0001
    logit_norm_tau: 0.0
    llrd: 1.0
    rope_base:             500000
    divisive_grad_c: 5.0
    grad_clip_after_divisive: true
    loss_var_window: 64
    loss_var_min_mult: 0.1
    vbb_kl_floor: 0.0
    vbb_kl_floor_gamma: 0.0
    pct_trunk:     0.0
    pct_strength:  0.0

    hardware: {
        gpu_name:        "A100_SXM4"
        num_gpus:        1
        min_gpu_mem_gib: 40
        min_reliability: 0.995
        min_inet_mbps:   200
        dist_strategy:   "single"
        precision:       "bf16"
    }

    # SmolLM's real trunk dims (640/8/10) — "interleave" + adapters at
    # this depth is ~134.8M trainable (measured 2026-07-12), within ~1%
    # of control-100m's 136.1M at depth=14. No further tuning needed:
    # the block-pattern change alone already lands in the same param
    # band as the standard-only control.
    scales: {
        default: "100m"

        100m: {
            d_model:       640
            depth:         8
            n_heads:       10
            max_ctx:       2048
            batch_size:    4
            seq_len:       2048
            grad_accum:    4
            approx_params: "~135M (param-matched to control-100m)"
        }
    }
}
